{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drop In",
  "identifier": "dk.skatepro.dropin",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "cargo build --release -p dropin"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Push Commits",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "SkatePro ApS",
    "shortDescription": "Push dialog that shows what a push sends before it goes",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4QjI2NDg2MDA1QTAwQzUKUldURkFGb0FobVN5dVB1cWdvbWsxMS9CVG9XQ244SjMrNENiNkhFb00vVWxPcktTcVBEYzVDelIK",
      "endpoints": ["https://github.com/SkatePro-ApS/dropin/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
